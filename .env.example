# .env.example — FakeCo "Real Appliances"
# Copy to .env and fill in values before running `docker compose up -d`.
# NEVER commit the real .env file — it is git-ignored.
# This file contains only key stubs (no values). See README for descriptions.

# =============================================================================
# PRINCIPAL (the human operator)
# =============================================================================
PRINCIPAL_EMAIL=
PRINCIPAL_NAME=

# =============================================================================
# LLM PROVIDER API KEYS
# =============================================================================
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local model endpoint (last-resort fallback — see litellm/README.md)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# =============================================================================
# POSTGRESQL (shared Postgres instance)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fakeco
POSTGRES_USER=
POSTGRES_PASSWORD=

# =============================================================================
# DOCKER-MAILSERVER
# =============================================================================
MAILSERVER_DOMAIN=fakecorp.internal
MAILSERVER_HOSTNAME=mail.fakecorp.internal
# Initial admin / postmaster address
POSTMASTER_EMAIL=

# =============================================================================
# ROUNDCUBE
# =============================================================================
ROUNDCUBE_DB_PASSWORD=
ROUNDCUBE_DES_KEY=

# =============================================================================
# MATTERMOST
# =============================================================================
MATTERMOST_DB_PASSWORD=
MATTERMOST_ADMIN_USER=
MATTERMOST_ADMIN_PASSWORD=
MATTERMOST_ADMIN_EMAIL=
# Optional Mattermost UI identity; defaults to MATTERMOST_ADMIN_EMAIL.
MATTERMOST_HUMAN_EMAIL=
MATTERMOST_SITE_URL=http://mattermost.fakecorp.internal
#
# --- First-boot bootstrap secrets (cannot be filled in before first boot) ---
# The three vars below don't exist until Mattermost has booted once with the
# admin account above already created. Leave them blank for the very first
# `docker compose up`, then come back and fill them in — several services
# (orchestrator, human-bridge, meeting-simulator) need them to talk to
# Mattermost and will silently fail to post/react without them.
#
# MATTERMOST_ADMIN_TOKEN — a Personal Access Token for the admin account.
#   1. `docker exec fakeco-mattermost mmctl auth login http://localhost:8065 \
#        --name local --username <MATTERMOST_ADMIN_USER> --password-file /dev/stdin`
#      (pipe the admin password in, or use --password on trusted hosts)
#   2. `docker exec fakeco-mattermost mmctl token generate <MATTERMOST_ADMIN_USER> "fakeco-automation"`
#   3. Copy the printed token here.
#   (Requires MM_SERVICESETTINGS_ENABLEUSERACCESSTOKENS=true, already set by
#   this compose file's mattermost service — no action needed for that part.)
MATTERMOST_ADMIN_TOKEN=
#
# MATTERMOST_BOT_TOKEN — a dedicated bot account token used for impersonating
# employees when posting simulated chat messages (kept separate from the
# admin token so employee posts aren't attributed to the admin account).
#   1. System Console → Integrations → Bot Accounts → Add Bot Account
#      (or `docker exec fakeco-mattermost mmctl bot create <name> --display-name "FakeCo Bot"`)
#   2. Generate a token for that bot account the same way as the admin token
#      above (`mmctl token generate <bot-username> "fakeco-bot"`).
#   3. Copy the printed token here.
MATTERMOST_BOT_TOKEN=
#
# MATTERMOST_TEAM_ID — the internal ID of the team employees get added to.
#   `docker exec fakeco-mattermost mmctl team list` and copy the ID of the
#   team you want to use (create one first via the web UI if none exist yet).
MATTERMOST_TEAM_ID=
#
# PRINCIPAL_MATTERMOST_PASSWORD — the Principal's own human login password
# for Mattermost (separate from MATTERMOST_ADMIN_PASSWORD — this is the
# account a real person logs into day-to-day, which may or may not be the
# same account as the admin one depending on how you provision it). Set this
# to whatever password you actually create for that account in Mattermost's
# UI on first login.
PRINCIPAL_MATTERMOST_PASSWORD=

# =============================================================================
# ZAMMAD
# =============================================================================
ZAMMAD_DB_PASSWORD=
ZAMMAD_ADMIN_USER=
ZAMMAD_ADMIN_PASSWORD=
ZAMMAD_ADMIN_EMAIL=
#
# ZAMMAD_ADMIN_TOKEN — first-boot bootstrap secret, leave blank until Zammad
# has completed its own setup wizard once with the admin account above.
#   Log into Zammad as the admin → Manage → API → click "+" to create a new
#   token for that user. Copy it here. (Every custom service that creates
#   Zammad tickets/reads them uses this token, not the admin password.)
ZAMMAD_ADMIN_TOKEN=

# =============================================================================
# WIKI.JS
# =============================================================================
WIKIJS_DB_PASSWORD=
WIKIJS_ADMIN_EMAIL=
WIKIJS_ADMIN_PASSWORD=
#
# WIKIJS_ADMIN_TOKEN — first-boot bootstrap secret, leave blank until Wiki.js
# has booted once and the admin account above has logged in.
#   Admin panel → Utilities → API Access → enable the GraphQL API if it's
#   off, then Users → your admin account → API Keys → create a new key
#   (full access). Copy the generated JWT here.
WIKIJS_ADMIN_TOKEN=

# =============================================================================
# AKAUNTING (accounting appliance)
# =============================================================================
AKAUNTING_DB_PASSWORD=
AKAUNTING_ADMIN_EMAIL=
AKAUNTING_ADMIN_PASSWORD=
AKAUNTING_COMPANY_NAME=FakeCo
# Starting cash balance posted to Akaunting at first boot
AKAUNTING_STARTING_CASH_BALANCE=
#
# --- Chart-of-accounts IDs (first-boot bootstrap) ---
# All default to 0 (meaning "unset") if left blank, which will make
# accounting-engine's transaction posting fail with an Akaunting validation
# error the first time it tries to post anything. Leave blank until you've
# logged into Akaunting once and set up its chart of accounts, then fill
# these in with the real numeric IDs (visible in each item's edit-page URL
# in the Akaunting admin UI, e.g. .../accounts/3/edit -> 3).
AKAUNTING_EXPENSE_ACCOUNT_ID=0
AKAUNTING_EXPENSE_CATEGORY_ID=0
AKAUNTING_REVENUE_ACCOUNT_ID=0
AKAUNTING_REVENUE_CATEGORY_ID=0
AKAUNTING_PAYROLL_ACCOUNT_ID=0
AKAUNTING_PAYROLL_CATEGORY_ID=0
# LLM API spend gets posted back to the books as a recurring expense so the
# simulated company's burn rate reflects real LiteLLM usage cost.
AKAUNTING_LLM_EXPENSE_ACCOUNT_ID=0

# =============================================================================
# NEXTCLOUD
# =============================================================================
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_DB_PASSWORD=

# =============================================================================
# WORDPRESS
# =============================================================================
WORDPRESS_DB_PASSWORD=
WORDPRESS_ADMIN_USER=
WORDPRESS_ADMIN_PASSWORD=
WORDPRESS_ADMIN_EMAIL=
#
# WORDPRESS_ADMIN_APP_PASSWORD — first-boot bootstrap secret, leave blank
# until WordPress has completed its install wizard with the admin account
# above (a fresh WordPress container does NOT auto-run the install wizard —
# you must complete it once via the web UI or `wp core install` before
# anything else works). Application Passwords are required for the REST API
# (used by human-bridge to publish narrative-driven blog posts) — regular
# login passwords are rejected by the REST API in modern WordPress.
#   wp-admin → Users → your profile → Application Passwords → give it a name
#   (e.g. "fakeco-human-bridge") → Add New Application Password. Copy the
#   generated value here immediately — WordPress only shows it once.
WORDPRESS_ADMIN_APP_PASSWORD=

# =============================================================================
# TECHNITIUM DNS SERVER
# =============================================================================
TECHNITIUM_ADMIN_PASSWORD=

# =============================================================================
# LITELLM PROXY
# =============================================================================
LITELLM_MASTER_KEY=
LITELLM_DATABASE_URL=

# =============================================================================
# GRAFANA
# =============================================================================
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# =============================================================================
# SIM CLOCK
# =============================================================================
# Starting speed multiplier (0.1 to 10.0, default 1.0)
SPEED_MULTIPLIER=1.0

# =============================================================================
# TRAEFIK
# =============================================================================
TRAEFIK_DASHBOARD_PASSWORD=

# =============================================================================
# MAILSERVER BOT SECRET (shared by provisioning / human-bridge / external-world
# to derive per-mailbox passwords deterministically)
# =============================================================================
MAILSERVER_BOT_SECRET=

# =============================================================================
# DOCKER SOCKET PROXY
# =============================================================================
# No additional credentials — access controlled by network placement + allow-list.
# Allowed ops: START, STOP, RESTART on labeled containers only.

# =============================================================================
# INTERNAL DOMAIN
# =============================================================================
FAKECORP_DOMAIN=fakecorp.internal

# =============================================================================
# CONTROL DASHBOARD (Phase 33+)
# =============================================================================
# HTTP Basic Auth credentials for the ENTIRE dashboard (API + SPA) — single
# Principal user. No default is provided; the dashboard container refuses to
# start (compose ":?" required-var syntax) until both are set.
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASSWORD=

# Phase 34: Accounting tab's "Open in Akaunting" deep link + cash-balance
# widget (company scoping — same value accounting-engine already uses).
AKAUNTING_COMPANY_ID=1
AKAUNTING_PUBLIC_URL=http://accounting.fakecorp.internal

# =============================================================================
# SIMULATION TUNING (all optional — every one of these has a working default
# baked into docker-compose.yml; only set these if you want to change the
# simulation's pacing/behavior from the defaults noted below)
# =============================================================================
# Orchestrator tick interval, wall-clock seconds. Default: 60
ORCHESTRATOR_TICK_INTERVAL=

# PTO (Phase 19) — daily probability an eligible employee starts PTO, minimum
# gap between an employee's PTO stints, and min/max PTO duration in sim-days.
# Defaults: 0.01 / 45 / 3 / 7
PTO_DAILY_PROBABILITY=
PTO_MIN_GAP_DAYS=
PTO_DURATION_MIN_DAYS=
PTO_DURATION_MAX_DAYS=

# Expense auto-approval thresholds (amounts at or under these auto-approve
# instead of queuing for Principal review). Defaults: IC $25.00, Lead $500.00
IC_AUTO_APPROVE_LIMIT=
LEAD_AUTO_APPROVE_LIMIT=

# KPI-driven performance review (Phase 23) tuning. approval_mode "off" applies
# raises automatically; any other value queues them for review instead (also
# live-switchable from the dashboard's KPI tab without restarting anything).
# Defaults: off / 30 / 2 / 90 / 0.05 / 0.02
KPI_REVIEW_APPROVAL_MODE=
KPI_REVIEW_LOOKBACK_DAYS=
KPI_REVIEW_MIN_DEPT_SIZE=
KPI_REVIEW_MIN_TENURE_DAYS=
KPI_REVIEW_TOP_RAISE_PCT=
KPI_REVIEW_SECOND_RAISE_PCT=

# Narrative-driven WordPress/Nextcloud deliverable fulfillment loop (see
# bugs.md for known issues with this feature). Poll interval, and retry
# backoff/cap for a failed deliverable. Defaults: 30 / 5 / 30 / 3600
DELIVERABLE_POLL_INTERVAL_SECONDS=
DELIVERABLE_MAX_ATTEMPTS=
DELIVERABLE_RETRY_BASE_SECONDS=
DELIVERABLE_RETRY_MAX_SECONDS=

# Principal-reaction fulfillment loop (in-character employee replies to the
# Principal's own Mattermost/email/Zammad/Wiki.js activity) — same
# poll/retry-backoff shape as the deliverable loop above.
# Defaults: 5 / 5 / 30 / 3600
REACTION_POLL_INTERVAL_SECONDS=
REACTION_MAX_ATTEMPTS=
REACTION_RETRY_BASE_SECONDS=
REACTION_RETRY_MAX_SECONDS=
