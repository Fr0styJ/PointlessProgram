{
  "title": "HTTP/DNS/Mail Traffic & Per-Appliance Activity",
  "uid": "fakeco-traffic-activity",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Traefik HTTP Request Rate (per hostname)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum by (container) (count_over_time({container=\"fakeco-traefik\"} | json | RequestHost != \"\" [1m]))",
          "legendFormat": "traefik requests/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Technitium DNS Log Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({container=\"fakeco-dns\"}[1m]))",
          "legendFormat": "dns log lines/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Mail (docker-mailserver) Log Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({container=\"fakeco-mailserver\"}[1m]))",
          "legendFormat": "mail log lines/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Per-Appliance Log Activity Rate (all containers)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum by (container) (count_over_time({container=~\"fakeco-.+\"}[1m]))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Live Traefik + Technitium Log Tail",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        { "expr": "{container=~\"fakeco-traefik|fakeco-dns\"}", "refId": "A" }
      ]
    }
  ]
}
